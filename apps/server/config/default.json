{
  "openapiConfig": {
    "filePath": "./openapi3.yaml",
    "basePath": "/docs",
    "rawPath": "/api",
    "uiPath": "/api"
  },
  "telemetry": {
    "metrics": {},
    "tracing": {
      "isEnabled": false
    },
    "shared": {},
    "logger": {
      "level": "info",
      "prettyPrint": false,
      "opentelemetryOptions": {
        "enabled": false
      }
    }
  },
  "server": {
    "port": 8080,
    "request": {
      "payload": {
        "limit": "20mb"
      }
    },
    "response": {
      "compression": {
        "enabled": true,
        "options": null
      }
    }
  },
  "populator": {
    "url": "http://localhost:8081"
  },
  "app": {
    "projectName": "default",
    "tilesBatchSize": 10000,
    "metatileSize": 8
  },
  "db": {
    "host": "localhost",
    "port": 5432,
    "username": "postgres",
    "password": "postgres",
    "schema": "pgboss",
    "createSchema": false,
    "migrate": false,
    "ssl": {
      "enabled": false,
      "ca": "",
      "key": "",
      "cert": ""
    },
    "database": "postgres"
  }
}
